# quant-platform environment variables
# Copy to .env and fill in real values:  cp .env.example .env

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:5432/quant_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
TOKEN_COOKIE_SECURE=false
TOKEN_COOKIE_SAMESITE=lax

# CSRF
CSRF_SECRET_TOKEN=change-me-to-another-long-random-string